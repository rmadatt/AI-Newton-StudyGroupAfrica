import numpy as np
from gplearn.genetic import SymbolicRegressor

# 1. Generate pure mechanical simulation data for 1D elastic collisions
np.random.seed(42)
n_trials = 500

# Physical masses of colliding particles (in kilograms)
mass_particle_1 = 2.0
mass_particle_2 = 3.0

# Initial velocities before collision (in meters per second)
v1_initial = np.random.uniform(2.0, 8.0, n_trials)
v2_initial = np.random.uniform(-6.0, -1.0, n_trials)

# Ground-truth physics calculation governed by momentum and kinetic energy conservation:
# v1_final = ((m1 - m2) * v1_init + 2 * m2 * v2_init) / (m1 + m2)
v1_final = ((mass_particle_1 - mass_particle_2) * v1_initial + 2 * mass_particle_2 * v2_initial) / (mass_particle_1 + mass_particle_2)

# 2. Construct the Pure Physics Feature Matrix (X) and Target Vector (y)
# X[:, 0] represents Particle 1's initial velocity
# X[:, 1] represents Particle 2's initial velocity
X = np.column_stack((v1_initial, v2_initial))
y = v1_final

# 3. Initialize Genetic Programming (AI-Newton core mechanism)
physics_law_discoverer = SymbolicRegressor(
    population_size=4000,
    generations=25,
    tournament_size=20,
    stopping_criteria=1e-5,
    p_crossover=0.7,
    p_subtree_mutation=0.15,
    p_point_mutation=0.1,
    verbose=1,
    random_state=42,
    function_set=('add', 'sub', 'mul', 'div')
)

# 4. Execute the discovery process tabula rasa from raw mechanics data
print("--- Discovering Pure Physics Elastic Collision Law ---")
physics_law_discoverer.fit(X, y)

# 5. Output the discovered mathematical law of motion
print("\n--- Discovery Results ---")
print("Discovered Physical Formula:", physics_law_discoverer._program)
